{
  "name": "simplyopen-history",
  "version": "0.1.0",
  "private": true,
  "description": "SimplyOpen History: version history for every project, like GitHub for people who never want to touch git. Plain-English, AI-written descriptions; nothing is ever lost.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/history.js",
  "types": "dist/history.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fastify/multipart": "^10.1.8",
    "diff": "^9.0.0",
    "fastify": "^5.12.8",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}

# Values need no quotes. Add double quotes only if a value contains a
# space or a # character, which a database password sometimes does.
# Never commit this file. It is already in .gitignore.

# Supabase, Project Settings then Database. Use the pooled connection string.
DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres

# Supabase storage. The service key is server side only, never in the frontend.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=files

# Your teammates' Analyzer.
ANALYZER_URL=http://127.0.0.1:3000/analyze

# Their chat service, for the chat room.
CHAT_URL=http://127.0.0.1:3100

# Who chooses "Picks from the team": email addresses, separated by commas.
# An address only counts once its owner has signed in by emailed link.
TEAM_EMAILS=

# The Factory. The token needs actions write on the repository.
GITHUB_OWNER=akondreddy
GITHUB_REPO=simplyopen
GITHUB_TOKEN=
# Optional. The branch whose Factory builds the apps. Leave empty for main.
FACTORY_REF=

PORT=3200
SITE_URL=http://localhost:3200

# Real sign in emails, through Resend (resend.com). Make a free account, create an
# API key, and paste it here. Without it the link prints in the API's terminal and
# the check your email page shows it as a button.
RESEND_API_KEY=
# With Resend's own test sender, email only reaches the address your Resend account
# was made with. To email anyone, verify a domain in Resend and put an address on it here.
MAIL_FROM=

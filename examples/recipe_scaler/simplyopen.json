{
  "name": "Recipe Scaler",
  "description": "Make a recipe bigger or smaller: every amount is multiplied for you.",
  "manifest": {
    "schema_version": "1.0",
    "project_kind": "app_or_tool",
    "project": {
      "language": "python",
      "language_version": null,
      "entry_points": [
        {
          "id": "scale",
          "path": "scale.py",
          "working_directory": "",
          "run_command": "python scale.py {args}",
          "description": "Scales the amounts in one recipe.",
          "interface": {
            "kind": "command_line",
            "exits_on_its_own": true,
            "controls": [],
            "prompts": [],
            "server": null
          }
        }
      ],
      "primary_entry_point": "scale",
      "build_command": null,
      "assets": []
    },
    "inputs": [
      {
        "id": "file",
        "kind": "file",
        "label": "Recipe",
        "help": "One ingredient per line, starting with its amount.",
        "required": true,
        "accepts": [
          ".txt"
        ],
        "multiple": false,
        "min": null,
        "max": null,
        "secret": false,
        "cli_binding": "{value}",
        "env_binding": null
      },
      {
        "id": "times",
        "kind": "number",
        "label": "Multiply by",
        "help": "2 doubles the recipe, 0.5 halves it.",
        "required": true,
        "multiple": false,
        "min": 0,
        "max": null,
        "secret": false,
        "cli_binding": "--times {value}",
        "env_binding": null
      },
      {
        "id": "output_dir",
        "kind": "folder",
        "label": "Folder to save the result in",
        "help": null,
        "required": true,
        "multiple": false,
        "min": null,
        "max": null,
        "secret": false,
        "cli_binding": "--output-dir {value}",
        "env_binding": null
      }
    ],
    "outputs": [
      {
        "id": "scaled",
        "kind": "file",
        "label": "Scaled recipe",
        "path_pattern": "{output_dir}/*_scaled.*"
      }
    ],
    "dependencies": {
      "runtime": [
        "python>=3.9"
      ],
      "packages": [],
      "system": [],
      "operating_systems": [
        "macos",
        "windows",
        "linux"
      ]
    },
    "capabilities": {
      "network_access": false,
      "filesystem_access": "declared_inputs_outputs_only",
      "reads_env_vars": [],
      "runs_other_programs": false
    },
    "confidence": {
      "overall": "high",
      "notes": []
    }
  }
}

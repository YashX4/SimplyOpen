{
  "name": "Flashcard Maker",
  "description": "Turn a list of questions and answers into study cards you can click to flip, or print.",
  "manifest": {
    "schema_version": "1.0",
    "project_kind": "app_or_tool",
    "project": {
      "language": "python",
      "language_version": null,
      "entry_points": [
        {
          "id": "flashcards",
          "path": "flashcards.py",
          "working_directory": "",
          "run_command": "python flashcards.py {args}",
          "description": "Makes a page of flashcards.",
          "interface": {
            "kind": "command_line",
            "exits_on_its_own": true,
            "controls": [],
            "prompts": [],
            "server": null
          }
        }
      ],
      "primary_entry_point": "flashcards",
      "build_command": null,
      "assets": []
    },
    "inputs": [
      {
        "id": "file",
        "kind": "file",
        "label": "Questions and answers",
        "help": "Question in the first column, answer in the second.",
        "required": true,
        "accepts": [
          ".csv"
        ],
        "multiple": false,
        "min": null,
        "max": null,
        "secret": false,
        "cli_binding": "{value}",
        "env_binding": null
      },
      {
        "id": "title",
        "kind": "text",
        "label": "Title",
        "help": null,
        "required": false,
        "multiple": false,
        "min": null,
        "max": null,
        "secret": false,
        "cli_binding": "--title {value}",
        "env_binding": null,
        "default": "Flashcards"
      },
      {
        "id": "output_dir",
        "kind": "folder",
        "label": "Folder to save the result in",
        "help": null,
        "required": true,
        "multiple": false,
        "min": null,
        "max": null,
        "secret": false,
        "cli_binding": "--output-dir {value}",
        "env_binding": null
      }
    ],
    "outputs": [
      {
        "id": "cards",
        "kind": "file",
        "label": "Flashcards",
        "path_pattern": "{output_dir}/flashcards.html"
      }
    ],
    "dependencies": {
      "runtime": [
        "python>=3.9"
      ],
      "packages": [],
      "system": [],
      "operating_systems": [
        "macos",
        "windows",
        "linux"
      ]
    },
    "capabilities": {
      "network_access": false,
      "filesystem_access": "declared_inputs_outputs_only",
      "reads_env_vars": [],
      "runs_other_programs": false
    },
    "confidence": {
      "overall": "high",
      "notes": []
    }
  }
}

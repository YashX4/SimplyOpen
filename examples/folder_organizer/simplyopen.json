{
  "name": "Folder Organizer",
  "description": "Sort a messy folder into tidy folders by type: Pictures, Documents, Music and so on.",
  "manifest": {
    "schema_version": "1.0",
    "project_kind": "app_or_tool",
    "project": {
      "language": "python",
      "language_version": null,

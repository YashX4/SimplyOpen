{
  "name": "Log Summarizer",
  "description": "Read a long program log and see how many errors and warnings it has and which come up most.",
  "manifest": {
    "schema_version": "1.0",
    "project_kind": "app_or_tool",
    "project": {
      "language": "python",
      "language_version": null,
      "entry_points": [
        {
          "id": "summarize",
          "path": "summarize.py",
          "working_directory": "",
          "run_command": "python summarize.py {args}",
          "description": "Summarizes one log file.",
          "interface": {
            "kind": "command_line",
            "exits_on_its_own": true,
            "controls": [],
            "prompts": [],
            "server": null
          }
        }
      ],
      "primary_entry_point": "summarize",
      "build_command": null,
      "assets": []
    },
    "inputs": [
      {
        "id": "file",
        "kind": "file",
        "label": "Log file",
        "help": null,
        "required": true,
        "accepts": [
          ".log",
          ".txt"
        ],
        "multiple": false,
        "min": null,
        "max": null,
        "secret": false,
        "cli_binding": "{value}",
        "env_binding": null
      },
      {
        "id": "top",
        "kind": "number",
        "label": "Repeated messages to list",
        "help": null,
        "required": false,
        "multiple": false,
        "min": 1,
        "max": null,
        "secret": false,
        "cli_binding": "--top {value}",
        "env_binding": null,
        "default": 5
      },
      {
        "id": "output_dir",
        "kind": "folder",
        "label": "Folder to save the result in",
        "help": null,
        "required": true,
        "multiple": false,
        "min": null,
        "max": null,
        "secret": false,
        "cli_binding": "--output-dir {value}",
        "env_binding": null
      }
    ],
    "outputs": [
      {
        "id": "summary",
        "kind": "file",
        "label": "Summary",
        "path_pattern": "{output_dir}/log_summary.txt"
      }
    ],
    "dependencies": {
      "runtime": [
        "python>=3.9"
      ],
      "packages": [],
      "system": [],
      "operating_systems": [
        "macos",
        "windows",
        "linux"
      ]
    },
    "capabilities": {
      "network_access": false,
      "filesystem_access": "declared_inputs_outputs_only",
      "reads_env_vars": [],
      "runs_other_programs": false
    },
    "confidence": {
      "overall": "high",
      "notes": []
    }
  }
}

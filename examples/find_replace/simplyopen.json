{
  "name": "Find and Replace",
  "description": "Swap one word or phrase for another everywhere in a text file.",
  "manifest": {
    "schema_version": "1.0",
    "project_kind": "app_or_tool",
    "project": {
      "language": "python",
      "language_version": null,
      "entry_points": [
        {
          "id": "replace",
          "path": "replace.py",
          "working_directory": "",
          "run_command": "python replace.py {args}",
          "description": "Replaces a phrase throughout one file.",
          "interface": {
            "kind": "command_line",
            "exits_on_its_own": true,
            "controls": [],
            "prompts": [],
            "server": null
          }
        }
      ],
      "primary_entry_point": "replace",
      "build_command": null,
      "assets": []
    },
    "inputs": [
      {
        "id": "file",
        "kind": "file",
        "label": "Text file to change",
        "help": null,
        "required": true,
        "accepts": [
          ".txt",
          ".md",
          ".csv",
          ".html"
        ],
        "multiple": false,
        "min": null,
        "max": null,
        "secret": false,
        "cli_binding": "{value}",
        "env_binding": null
      },
      {
        "id": "find",
        "kind": "text",
        "label": "Words to look for",
        "help": null,
        "required": true,
        "multiple": false,
        "min": null,
        "max": null,
        "secret": false,
        "cli_binding": "--find {value}",
        "env_binding": null
      },
      {
        "id": "replace",
        "kind": "text",
        "label": "Put this in their place",
        "help": "Leave empty to delete the words.",
        "required": false,
        "multiple": false,
        "min": null,
        "max": null,
        "secret": false,
        "cli_binding": "--replace {value}",
        "env_binding": null
      },
      {
        "id": "ignore_case",
        "kind": "boolean",
        "label": "Treat capitals and small letters the same",
        "help": null,
        "required": false,
        "multiple": false,
        "min": null,
        "max": null,
        "secret": false,
        "cli_binding": "--ignore-case",
        "env_binding": null
      },
      {
        "id": "output_dir",
        "kind": "folder",
        "label": "Folder to save the result in",
        "help": null,
        "required": true,
        "multiple": false,
        "min": null,
        "max": null,
        "secret": false,
        "cli_binding": "--output-dir {value}",
        "env_binding": null
      }
    ],
    "outputs": [
      {
        "id": "changed",
        "kind": "file",
        "label": "Changed file",
        "path_pattern": "{output_dir}/*_replaced.*"
      }
    ],
    "dependencies": {
      "runtime": [
        "python>=3.9"
      ],
      "packages": [],
      "system": [],
      "operating_systems": [
        "macos",
        "windows",
        "linux"
      ]
    },
    "capabilities": {
      "network_access": false,
      "filesystem_access": "declared_inputs_outputs_only",
      "reads_env_vars": [],
      "runs_other_programs": false
    },
    "confidence": {
      "overall": "high",
      "notes": []
    }
  }
}

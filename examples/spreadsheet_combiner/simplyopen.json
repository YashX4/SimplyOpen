{
  "name": "Spreadsheet Combiner",
  "description": "Combine several CSV spreadsheets into one, and optionally remove repeated rows.",
  "manifest": {
    "schema_version": "1.0",
    "project_kind": "app_or_tool",
    "project": {
      "language": "python",
      "language_version": null,

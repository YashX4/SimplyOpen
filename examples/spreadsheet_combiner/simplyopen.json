          "description": "Combines CSV files into one file called combined.csv.",
          "interface": {
            "kind": "command_line",
            "exits_on_its_own": true,
            "controls": [],
            "prompts": [],
            "server": null
          }
        }
      ],
      "primary_entry_point": "merge",
      "build_command": null,
      "assets": []
    },
    "inputs": [
      {
        "id": "files",
        "kind": "file",
        "label": "Spreadsheets to combine",
        "help": "Choose two or more CSV files.",
        "required": true,
        "accepts": [".csv"],
        "multiple": true,
        "min": null,
        "max": null,
        "secret": false,
        "cli_binding": "{value}",
        "env_binding": null
      },
      {
        "id": "output_dir",
        "kind": "folder",
        "label": "Folder to save the combined file in",
        "help": null,
        "required": true,
        "multiple": false,
        "min": null,
        "max": null,
        "secret": false,
        "cli_binding": "--output-dir {value}",
        "env_binding": null
      },
      {
        "id": "remove_duplicates",
        "kind": "boolean",
        "label": "Remove repeated rows",
        "help": null,
        "required": false,
        "multiple": false,
        "min": null,
        "max": null,
        "secret": false,
        "cli_binding": "--remove-duplicates",
        "env_binding": null
      },
      {
        "id": "sort_by",
        "kind": "text",

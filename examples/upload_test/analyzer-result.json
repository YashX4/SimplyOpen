{
  "name": "Transcript Converter",
  "description": "Gets Zoom transcripts ready for NVivo.",
  "manifest": {
    "schema_version": "1.0",
    "project_kind": "app_or_tool",
    "project": {
      "language": "python",
      "language_version": null,
      "entry_points": [
        {
          "id": "convert",
          "path": "zoom_to_nvivo.py",
          "working_directory": "",
          "run_command": "python zoom_to_nvivo.py {args}",
          "description": "Converts Zoom transcripts into plain text for NVivo.",
          "interface": {
            "kind": "command_line",
            "exits_on_its_own": true,
            "controls": [],
            "prompts": [],
            "server": null
          }
        }
      ],
      "primary_entry_point": "convert",
      "build_command": null,
      "assets": []
    },
    "inputs": [
      {
        "help": "Zoom transcript files (.vtt)",
        "required": true,
        "multiple": true,
        "min": null,
        "max": null,
        "secret": false,
        "cli_binding": "{value}",
        "env_binding": null,
        "id": "transcripts",
        "kind": "file",
        "label": "Zoom transcript files",
        "accepts": [
          ".vtt"
        ]
      },
      {
        "id": "output_dir",
        "kind": "folder",
        "label": "Folder for the converted files",
        "help": null,
        "required": true,
        "multiple": false,
        "min": null,
        "max": null,
        "secret": false,
        "cli_binding": "--output-dir {value}",
        "env_binding": null
      },
      {
        "help": null,
        "required": false,
        "multiple": false,
        "min": null,
        "max": null,
        "secret": false,
        "cli_binding": "--keep-timestamps",
        "env_binding": null,
        "id": "keep_timestamps",
        "kind": "boolean",
        "label": "Keep caption timestamps"
      }
    ],
    "outputs": [
      {
        "id": "converted",
        "kind": "folder",
        "label": "Converted transcripts",
        "path_pattern": "{output_dir}/*.txt"
      }
    ],
    "dependencies": {
      "runtime": [
        "python>=3.9"
      ],
      "packages": [],
      "system": [],
      "operating_systems": [
        "macos",
        "windows",
        "linux"
      ]
    },
    "capabilities": {
      "network_access": false,
      "filesystem_access": "declared_inputs_outputs_only",
      "reads_env_vars": [],
      "runs_other_programs": false
    },
    "confidence": {
      "overall": "high",
      "notes": []
    }
  }
}
